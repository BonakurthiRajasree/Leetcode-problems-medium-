
1.3  MINIMUM SUBARRAY OR SUBSTRING
Leetcode problem : 76 Minimum window substring
CODE :
class Solution(object):
    def minWindow(self, s, t):
        # s="ddaaabbca",t="abc"
        hashArray=[0]*256
        for char in t:
            hashArray[ord(char)]+=1
        left,right = 0,0
        minLen=float("inf")
        sIndex=-1
        count=0
        n=len(s)
        while(right<n):
            if(hashArray[ord(s[right])]>0):
                count+=1
            hashArray[ord(s[right])]-=1
            while(count == len(t)):
                if(right-left+1<minLen):
                    sIndex=left
                    minLen=min(minLen,right-left+1)
                hashArray[ord(s[left])]+=1
                if(hashArray[ord(s[left])]>0):
                    count-=1
                left+=1
            right+=1
        if(sIndex == -1):
            return ""
        return s[sIndex:sIndex+minLen]
Leetcode problem : 424 Longest repeating character replacement
Code :
class Solution(object):
    def characterReplacement(self, s, k):
        n=len(s)
        left,right = 0,0
        maxLen=0
        d={}
        maxF = 0
        while(right<n):
            if(s[right] in d):
                d[s[right]]+=1
            else:
                d[s[right]]=1
            maxF = max(maxF,d[s[right]])
            while((right-left+1)-maxF>k):
                d[s[left]]-=1
                if(d[s[left]]==0):
                    del d[s[left]]
                left+=1
            maxLen=max(maxLen,right-left+1)
            right+=1
        return maxLen
