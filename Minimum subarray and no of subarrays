Leetcode problem : 76 Minimum window substring
CODE :
class Solution(object):
    def minWindow(self, s, t):
        # s="ddaaabbca",t="abc"
        hashArray=[0]*256
        for char in t:
            hashArray[ord(char)]+=1
        left,right = 0,0
        minLen=float("inf")
        sIndex=-1
        count=0
        n=len(s)
        while(right<n):
            if(hashArray[ord(s[right])]>0):
                count+=1
            hashArray[ord(s[right])]-=1
            while(count == len(t)):
                if(right-left+1<minLen):
                    sIndex=left
                    minLen=min(minLen,right-left+1)
                hashArray[ord(s[left])]+=1
                if(hashArray[ord(s[left])]>0):
                    count-=1
                left+=1
            right+=1
        if(sIndex == -1):
            return ""
        return s[sIndex:sIndex+minLen]

Leetcode problem : 930 Binar subarrays with sum
Code :
class Solution(object):
    def numSubarraysWithSum(self, nums, goal):
        def func(nums,goal):
            if(goal<0):
                return 0
            Sum=0
            count=0
            n=len(nums)
            left,right = 0,0
            while(right<n):
                Sum+=nums[right]
                while(Sum>goal):
                    Sum-= nums[left]
                    left+=1
                count+=(right-left+1)
                right+=1
            return count
        return func(nums,goal) - func(nums,goal-1)

Leetcode problem : 455 Assign Cookies
Code :
class Solution(object):
    def findContentChildren(self, g, s):
        g.sort()
        s.sort()
        i=0
        j=0
        while(i<len(g) and j<len(s)):
            if(s[j]>=g[i]):
                i+=1
            j+=1
        return i
