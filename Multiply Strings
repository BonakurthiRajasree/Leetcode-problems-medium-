class Solution(object):
    def multiply(self, num1, num2):
        if num1 == "0" or num2 == "0":
            return "0"
        m = len(num1)
        n = len(num2)
        result = [0] * (m + n)
        for i in range(m - 1, -1, -1):
            for j in range(n - 1, -1, -1):
                mul = (ord(num1[i]) - ord('0')) * (ord(num2[j]) - ord('0'))
                p1 = i + j
                p2 = i + j + 1
                total = mul + result[p2]
                result[p2] = total % 10
                result[p1] += total // 10
        i = 0
        while i < len(result) and result[i] == 0:
            i += 1
        ans = ""
        while i < len(result):
            ans += str(result[i])
            i += 1
        return ans if ans else "0"
